go victoryprocess simflag="-p 4"

# TIME SWEEP — 10 min
init material=silicon depth=1 from="0,0" to="1,1" \
     gasheight=1 at=0.5 resolution=0.05 \
     meshdepth=2 flow.dim=2d

diffuse time=10 temp=1000 f.o2=1

extract name="tox_10" thickness material="SiO2" \
        mat.occno=1 x.val=0.5

export structure=tox_10min.str

# TIME SWEEP — 30 min
init material=silicon depth=1 from="0,0" to="1,1" \
     gasheight=1 at=0.5 resolution=0.05 \
     meshdepth=2 flow.dim=2d

diffuse time=30 temp=1000 f.o2=1

extract name="tox_30" thickness material="SiO2" \
        mat.occno=1 x.val=0.5

export structure=tox_30min.str

# TIME SWEEP — 60 min
init material=silicon depth=1 from="0,0" to="1,1" \
     gasheight=1 at=0.5 resolution=0.05 \
     meshdepth=2 flow.dim=2d

diffuse time=60 temp=1000 f.o2=1

extract name="tox_60" thickness material="SiO2" \
        mat.occno=1 x.val=0.5

export structure=tox_60min.str

# TIME SWEEP — 120 min
init material=silicon depth=1 from="0,0" to="1,1" \
     gasheight=1 at=0.5 resolution=0.05 \
     meshdepth=2 flow.dim=2d

diffuse time=120 temp=1000 f.o2=1

extract name="tox_120" thickness material="SiO2" \
        mat.occno=1 x.val=0.5

export structure=tox_120min.str

quit
